# Replace all placeholders locally. Do not commit your populated profile.
config_version: 1
control_plane:
  base_url: https://api.openai.com
  tunnel_id: REPLACE_WITH_TUNNEL_ID
  api_key: file:/home/USER/.config/openai-tunnel/control-plane-api-key
health:
  listen_addr: 127.0.0.1:0
admin_ui:
  open_browser: false
log:
  level: info
  format: json
mcp:
  startup_wait_timeout: 60s
  server_urls:
    - channel: main
      url: http://127.0.0.1:23374/v0/mcp
  extra_headers:
    Authorization: file:/home/USER/.config/openai-tunnel/beeper-authorization
